{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "classcheckqr",
          "appId": "1:816524800203:android:ce17887453c03400876b4e",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "classcheckqr",
          "configurations": {
