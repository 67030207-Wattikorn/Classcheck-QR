// Web client ID: Firebase Console > Authentication > Sign-in method > Google > Web SDK configuration
const kWebClientId = '816524800203-j6no7arilqku3pvi7mq09i152e79kf5m.apps.googleusercontent.com';
const kRadiusMeters = 1000.0; // รัศมีเช็คชื่อ (สไลด์ระบุ 1 กม.)
const kLateMinutes = 15; // เกินกี่นาทีนับว่า "สาย"

// ---------- palette ----------
const kBlue = Color(0xFF4F7FE8); // น้ำเงินจากสไลด์
const kBlueDeep = Color(0xFF2E55C9);
const kInk = Color(0xFF16213A);
const kMuted = Color(0xFF6B7690);
const kPaper = Color(0xFFF5F8FF);
const kLine = Color(0xFFE1E8F7);
const kOk = Color(0xFF1FA971);
const kLate = Color(0xFFF29B2C);
const kAbsent = Color(0xFFE5484D);
const kTiles = [kBlue, Color(0xFF2FB38A), Color(0xFFF2994A), Color(0xFF8B6BE0), Color(0xFFE2607D)];

bool gsiReady = false;
bool registering = false;

Future<void> main() async {
  WidgetsFlutterBinding.ensureInitialized();
  await Firebase.initializeApp(options: DefaultFirebaseOptions.currentPlatform);
  runApp(const App());
}

// ---------- helpers ----------
void toast(BuildContext c, String m) => ScaffoldMessenger.of(c).showSnackBar(SnackBar(
      content: Text(m),
      behavior: SnackBarBehavior.floating,
      backgroundColor: kInk,
      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
    ));

String p2(int n) => n.toString().padLeft(2, '0');
String fmt(DateTime? d) =>
    d == null ? '-' : '${p2(d.day)}/${p2(d.month)}/${d.year + 543} ${p2(d.hour)}:${p2(d.minute)}';
String fmtTime(DateTime? d) => d == null ? '-' : '${p2(d.hour)}:${p2(d.minute)} น.';

String genCode() {
  const ch = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
  final r = Random();
  return List.generate(6, (_) => ch[r.nextInt(ch.length)]).join();
}

Future<Position> getPos() async {
  if (!await Geolocator.isLocationServiceEnabled()) throw 'กรุณาเปิด GPS';
  var p = await Geolocator.checkPermission();
  if (p == LocationPermission.denied) p = await Geolocator.requestPermission();
  if (p == LocationPermission.denied || p == LocationPermission.deniedForever) {
    throw 'ไม่ได้รับสิทธิ์เข้าถึงตำแหน่ง';
  }
  return Geolocator.getCurrentPosition();
}

Future<List<String>?> askText(BuildContext c, String title, List<String> labels) {
  final ctrls = labels.map((_) => TextEditingController()).toList();
  return showDialog<List<String>>(
    context: c,
    builder: (_) => AlertDialog(
      backgroundColor: Colors.white,
      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(24)),
      title: Text(title, style: const TextStyle(fontWeight: FontWeight.w600)),
      content: Column(mainAxisSize: MainAxisSize.min, children: [
        for (var i = 0; i < labels.length; i++)
          Padding(
            padding: const EdgeInsets.only(top: 10),
            child: TextField(controller: ctrls[i], decoration: InputDecoration(labelText: labels[i])),
          ),
      ]),
      actions: [
        TextButton(onPressed: () => Navigator.pop(c), child: const Text('ยกเลิก')),
        FilledButton(
          style: FilledButton.styleFrom(minimumSize: const Size(96, 44)),
          onPressed: () => Navigator.pop(c, ctrls.map((e) => e.text.trim()).toList()),
          child: const Text('ตกลง'),
        ),
      ],
    ),
  );
}

Color statusColor(String s) =>
    s == 'ตรงเวลา' ? kOk : (s == 'สาย' ? kLate : (s == 'ขาด' ? kAbsent : kMuted));

// ---------- reusable widgets ----------
class Header extends StatelessWidget {
  final Widget child;
  const Header({super.key, required this.child});
  @override
  Widget build(BuildContext context) => Container(
        width: double.infinity,
        padding: EdgeInsets.fromLTRB(24, MediaQuery.of(context).padding.top + 20, 24, 28),
        decoration: const BoxDecoration(
          gradient: LinearGradient(
              begin: Alignment.topLeft, end: Alignment.bottomRight, colors: [kBlue, kBlueDeep]),
          borderRadius: BorderRadius.vertical(bottom: Radius.circular(32)),
        ),
        child: child,
      );
}

class StatusChip extends StatelessWidget {
  final String s;
  const StatusChip(this.s, {super.key});
  @override
  Widget build(BuildContext context) {
    final c = statusColor(s);
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 5),
      decoration: BoxDecoration(color: c.withValues(alpha: 0.12), borderRadius: BorderRadius.circular(20)),
      child: Text(s, style: TextStyle(color: c, fontWeight: FontWeight.w600, fontSize: 13)),
    );
  }
}

class EmptyState extends StatelessWidget {
  final IconData icon;
  final String title, hint;
  const EmptyState({super.key, required this.icon, required this.title, required this.hint});
  @override
  Widget build(BuildContext context) => Center(
        child: Padding(
          padding: const EdgeInsets.all(32),
          child: Column(mainAxisSize: MainAxisSize.min, children: [
            Container(
              width: 84,
              height: 84,
              decoration: BoxDecoration(color: kBlue.withValues(alpha: 0.1), shape: BoxShape.circle),
              child: Icon(icon, size: 40, color: kBlue),
            ),
            const SizedBox(height: 16),
            Text(title, style: const TextStyle(fontSize: 18, fontWeight: FontWeight.w600)),
