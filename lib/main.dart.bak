class Loading extends StatelessWidget {
  const Loading({super.key});
  @override
  Widget build(BuildContext context) => const Scaffold(body: Center(child: CircularProgressIndicator()));
}

// ---------- login / register ----------
class LoginPage extends StatefulWidget {
  const LoginPage({super.key});
  @override
  State<LoginPage> createState() => _LoginState();
}

class _LoginState extends State<LoginPage> {
  final email = TextEditingController(), pass = TextEditingController();
  final name = TextEditingController(), sid = TextEditingController();
  bool teacher = false, register = false, busy = false, hide = true;

  Future<void> submit() async {
    final e = email.text.trim();
    setState(() => busy = true);
    try {
      if (register) {
        if (teacher && !e.endsWith('@gmail.com')) throw 'อาจารย์ต้องใช้อีเมล @gmail.com';
        if (!teacher && !e.endsWith('@kmitl.ac.th')) throw 'นักศึกษาต้องใช้อีเมล @kmitl.ac.th';
        if (pass.text.length < 6) throw 'รหัสผ่านต้องมีอย่างน้อย 6 ตัวอักษร';
        if (name.text.trim().isEmpty) throw 'กรุณากรอกชื่อ-สกุล';
        if (!teacher && sid.text.trim().isEmpty) throw 'กรุณากรอกรหัสนักศึกษา';
        registering = true;
        final cr = await auth.createUserWithEmailAndPassword(email: e, password: pass.text);
        await db.doc('users/${cr.user!.uid}').set({
          'email': e,
          'name': name.text.trim(),
          'studentId': sid.text.trim(),
          'role': teacher ? 'teacher' : 'student',
        });
      } else {
        await auth.signInWithEmailAndPassword(email: e, password: pass.text);
      }
    } on FirebaseAuthException catch (ex) {
      final m = {
        'invalid-credential': 'อีเมลหรือรหัสผ่านไม่ถูกต้อง',
        'wrong-password': 'รหัสผ่านไม่ถูกต้อง',
        'user-not-found': 'ไม่พบบัญชีนี้',
        'email-already-in-use': 'อีเมลนี้ถูกใช้แล้ว',
        'invalid-email': 'รูปแบบอีเมลไม่ถูกต้อง',
      };
      if (mounted) toast(context, m[ex.code] ?? 'เกิดข้อผิดพลาด: ${ex.code}');
    } catch (ex) {
      if (mounted) toast(context, ex.toString());
    } finally {
      registering = false;
    }
    if (mounted) setState(() => busy = false);
  }

  Future<void> googleLogin() async {
    setState(() => busy = true);
    try {
      final UserCredential cr;
      if (kIsWeb) {
        cr = await auth.signInWithPopup(GoogleAuthProvider()..setCustomParameters({'prompt': 'select_account'}));
      } else {
        if (!gsiReady) {
          await GoogleSignIn.instance.initialize(serverClientId: kWebClientId);
          gsiReady = true;
        }
        final acc = await GoogleSignIn.instance.authenticate();
        final idToken = acc.authentication.idToken;
        if (idToken == null) throw 'ไม่ได้รับ ID token จาก Google';
        cr = await auth.signInWithCredential(GoogleAuthProvider.credential(idToken: idToken));
      }
      final e = cr.user?.email ?? '';
      if (!e.endsWith('@gmail.com') && !e.endsWith('@kmitl.ac.th')) {
        await auth.signOut();
        if (!kIsWeb) await GoogleSignIn.instance.signOut();
        throw 'ใช้ได้เฉพาะอีเมล @gmail.com (ครู) หรือ @kmitl.ac.th (นักศึกษา)';
      }
    } on GoogleSignInException catch (ex) {
      if (mounted && ex.code != GoogleSignInExceptionCode.canceled) {
        toast(context, 'Google: ${ex.code.name} ${ex.description ?? ''}');
      }
    } on FirebaseAuthException catch (ex) {
      if (mounted) toast(context, 'Firebase: ${ex.code}');
    } catch (ex) {
      if (mounted) toast(context, ex.toString());
    }
    if (mounted) setState(() => busy = false);
  }

  Widget roleButton(String label, IconData icon, bool value) {
    final on = teacher == value;
    return Expanded(
      child: GestureDetector(
        onTap: () => setState(() => teacher = value),
        child: AnimatedContainer(
          duration: const Duration(milliseconds: 180),
          padding: const EdgeInsets.symmetric(vertical: 14),
          decoration: BoxDecoration(
            color: on ? kBlue : Colors.white,
            borderRadius: BorderRadius.circular(14),
            border: Border.all(color: on ? kBlue : kLine, width: 1.5),
          ),
          child: Column(children: [
            Icon(icon, color: on ? Colors.white : kMuted),
            const SizedBox(height: 4),
            Text(label,
                style: TextStyle(
                    fontSize: 13, fontWeight: FontWeight.w600, color: on ? Colors.white : kMuted)),
          ]),
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) => Scaffold(
        body: Column(children: [
          Header(
            child: Column(children: [
              Container(
                width: 68,
                height: 68,
                decoration: BoxDecoration(color: Colors.white, borderRadius: BorderRadius.circular(20)),
                child: const Icon(Icons.qr_code_2_rounded, size: 42, color: kBlue),
              ),
              const SizedBox(height: 14),
              const Text('ClassCheck QR',
                  style: TextStyle(color: Colors.white, fontSize: 26, fontWeight: FontWeight.w700)),
              const SizedBox(height: 4),
              const Text('เช็คชื่อด้วย QR ครูเห็นผลทันที ไม่ต้องขานชื่อ',
                  textAlign: TextAlign.center, style: TextStyle(color: Colors.white70, fontSize: 14)),
            ]),
          ),
          Expanded(
            child: Center(
              child: ConstrainedBox(
                constraints: const BoxConstraints(maxWidth: 460),
                child: ListView(padding: const EdgeInsets.fromLTRB(24, 24, 24, 24), children: [
                  Text(register ? 'สร้างบัญชีใหม่' : 'เข้าสู่ระบบ',
                      style: const TextStyle(fontSize: 22, fontWeight: FontWeight.w700)),
                  const SizedBox(height: 16),
                  if (register) ...[
                    Row(children: [
                      roleButton('นักเรียน / นักศึกษา', Icons.school_outlined, false),
                      const SizedBox(width: 12),
                      roleButton('ครู / อาจารย์', Icons.badge_outlined, true),
                    ]),
                    const SizedBox(height: 14),
                    TextField(
                        controller: name,
                        decoration: const InputDecoration(
                            labelText: 'ชื่อ-สกุล', prefixIcon: Icon(Icons.person_outline))),
                    if (!teacher) ...[
                      const SizedBox(height: 12),
                      TextField(
                          controller: sid,
                          decoration: const InputDecoration(
                              labelText: 'รหัสนักศึกษา', prefixIcon: Icon(Icons.tag))),
                    ],
                    const SizedBox(height: 12),
                  ],
                  TextField(
                    controller: email,
                    keyboardType: TextInputType.emailAddress,
                    decoration: InputDecoration(
                      labelText: 'อีเมล',
                      prefixIcon: const Icon(Icons.mail_outline),
                      helperText: register ? (teacher ? 'ใช้ @gmail.com' : 'ใช้อีเมลสถาบัน @kmitl.ac.th') : null,
                    ),
                  ),
                  const SizedBox(height: 12),
                  TextField(
                    controller: pass,
                    obscureText: hide,
                    decoration: InputDecoration(
                      labelText: 'รหัสผ่าน',
                      prefixIcon: const Icon(Icons.lock_outline),
                      suffixIcon: IconButton(
                          icon: Icon(hide ? Icons.visibility_off_outlined : Icons.visibility_outlined),
                          onPressed: () => setState(() => hide = !hide)),
                    ),
                  ),
                  const SizedBox(height: 22),
                  FilledButton(
                    onPressed: busy ? null : submit,
                    child: busy
                        ? const SizedBox(
                            width: 22,
                            height: 22,
                            child: CircularProgressIndicator(strokeWidth: 2.5, color: Colors.white))
                        : Text(register ? 'สมัครสมาชิก' : 'เข้าสู่ระบบ'),
                  ),
                  const SizedBox(height: 18),
                  Row(children: const [
                    Expanded(child: Divider(color: kLine)),
                    Padding(
                        padding: EdgeInsets.symmetric(horizontal: 12),
                        child: Text('หรือ', style: TextStyle(color: kMuted))),
                    Expanded(child: Divider(color: kLine)),
                  ]),
                  const SizedBox(height: 18),
                  OutlinedButton.icon(
                    onPressed: busy ? null : googleLogin,
                    icon: const Icon(Icons.account_circle_outlined, color: kBlue),
                    label: const Text('เข้าสู่ระบบด้วย Google'),
                  ),
                  const SizedBox(height: 8),
                  TextButton(
                    onPressed: () => setState(() => register = !register),
                    child: Text(register ? 'มีบัญชีแล้ว? เข้าสู่ระบบ' : 'ยังไม่มีบัญชี? สมัครสมาชิก'),
                  ),
                ]),
              ),
            ),
          ),
        ]),
      );
}

// ---------- gate + profile ----------
class Gate extends StatelessWidget {
  const Gate({super.key});
  @override
  Widget build(BuildContext context) => StreamBuilder<DocumentSnapshot<Map<String, dynamic>>>(
        stream: db.doc('users/${auth.currentUser!.uid}').snapshots(),
        builder: (c, s) {
          if (!s.hasData) return const Loading();
          if (!s.data!.exists) return registering ? const Loading() : const ProfileSetup();
          return Home(user: s.data!.data()!);
        },
      );
}

class ProfileSetup extends StatefulWidget {
  const ProfileSetup({super.key});
  @override
  State<ProfileSetup> createState() => _ProfileSetupState();
}

class _ProfileSetupState extends State<ProfileSetup> {
  final name = TextEditingController(text: auth.currentUser?.displayName ?? '');
  final sid = TextEditingController();
  final email = auth.currentUser?.email ?? '';
  late final bool teacher = !email.endsWith('@kmitl.ac.th');

  Future<void> save() async {
    if (name.text.trim().isEmpty) return toast(context, 'กรุณากรอกชื่อ-สกุล');
    if (!teacher && sid.text.trim().isEmpty) return toast(context, 'กรุณากรอกรหัสนักศึกษา');
    await db.doc('users/${auth.currentUser!.uid}').set({
      'email': email,
      'name': name.text.trim(),
      'studentId': sid.text.trim(),
      'role': teacher ? 'teacher' : 'student',
    });
  }

  @override
  Widget build(BuildContext context) => Scaffold(
        body: Column(children: [
          Header(
            child: Row(children: [
              Expanded(
                child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
                  const Text('ตั้งค่าโปรไฟล์',
                      style: TextStyle(color: Colors.white, fontSize: 24, fontWeight: FontWeight.w700)),
                  const SizedBox(height: 4),
                  Text(email, style: const TextStyle(color: Colors.white70)),
                  const SizedBox(height: 10),
                  Container(
                    padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 5),
                    decoration: BoxDecoration(
                        color: Colors.white.withValues(alpha: 0.2), borderRadius: BorderRadius.circular(20)),
                    child: Text(teacher ? 'ครู / อาจารย์' : 'นักเรียน / นักศึกษา',
                        style: const TextStyle(color: Colors.white, fontWeight: FontWeight.w500)),
                  ),
                ]),
              ),
              IconButton(onPressed: auth.signOut, icon: const Icon(Icons.logout, color: Colors.white)),
            ]),
          ),
          Expanded(
            child: ListView(padding: const EdgeInsets.all(24), children: [
              TextField(
                  controller: name,
                  decoration:
                      const InputDecoration(labelText: 'ชื่อ-สกุล', prefixIcon: Icon(Icons.person_outline))),
              if (!teacher) ...[
                const SizedBox(height: 12),
                TextField(
                    controller: sid,
                    decoration: const InputDecoration(labelText: 'รหัสนักศึกษา', prefixIcon: Icon(Icons.tag))),
              ],
              const SizedBox(height: 22),
              FilledButton(onPressed: save, child: const Text('บันทึกและเริ่มใช้งาน')),
            ]),
          ),
        ]),
      );
}

// ---------- home ----------
class Home extends StatelessWidget {
  final Map<String, dynamic> user;
  const Home({super.key, required this.user});
  bool get isT => user['role'] == 'teacher';

  Future<void> createClass(BuildContext c) async {
    final v = await askText(c, 'สร้างชั้นเรียน', ['ชื่อวิชา', 'รหัสวิชา']);
    if (v == null || v[0].isEmpty) return;
    await db.collection('classes').add({
      'name': v[0],
      'subjectCode': v[1],
      'code': genCode(),
      'teacherId': auth.currentUser!.uid,
      'members': [],
    });
  }

  Future<void> joinClass(BuildContext c) async {
    final v = await askText(c, 'เข้าร่วมชั้นเรียน', ['รหัสห้อง 6 ตัว']);
    if (v == null || v[0].isEmpty) return;
    final q = await db.collection('classes').where('code', isEqualTo: v[0].toUpperCase()).limit(1).get();
    if (q.docs.isEmpty) {
      if (c.mounted) toast(c, 'ไม่พบรหัสห้องนี้ ตรวจสอบรหัสกับอาจารย์อีกครั้ง');
      return;
    }
    final uid = auth.currentUser!.uid;
    final ref = q.docs.first.reference;
    await ref.update({'members': FieldValue.arrayUnion([uid])});
    await ref.collection('students').doc(uid).set({'name': user['name'], 'studentId': user['studentId']});
    if (c.mounted) toast(c, 'เข้าร่วมชั้นเรียนแล้ว');
  }

  @override
  Widget build(BuildContext context) {
    final uid = auth.currentUser!.uid;
    final q = isT
        ? db.collection('classes').where('teacherId', isEqualTo: uid)
        : db.collection('classes').where('members', arrayContains: uid);
    return Scaffold(
      floatingActionButton: FloatingActionButton.extended(
        onPressed: () => isT ? createClass(context) : joinClass(context),
        icon: Icon(isT ? Icons.add_rounded : Icons.login_rounded),
        label: Text(isT ? 'สร้างชั้นเรียน' : 'เข้าร่วมชั้นเรียน'),
      ),
      body: Column(children: [
        Header(
          child: Row(children: [
            Expanded(
              child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
                const Text('สวัสดี', style: TextStyle(color: Colors.white70, fontSize: 14)),
                Text('${user['name'] ?? ''}',
                    maxLines: 1,
                    overflow: TextOverflow.ellipsis,
                    style: const TextStyle(color: Colors.white, fontSize: 24, fontWeight: FontWeight.w700)),
                const SizedBox(height: 10),
                Container(
                  padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 5),
                  decoration: BoxDecoration(
                      color: Colors.white.withValues(alpha: 0.2), borderRadius: BorderRadius.circular(20)),
                  child: Text(isT ? 'ครู / อาจารย์' : 'นักเรียน / นักศึกษา',
                      style: const TextStyle(color: Colors.white, fontWeight: FontWeight.w500)),
                ),
              ]),
            ),
            IconButton(
                tooltip: 'ออกจากระบบ',
                onPressed: auth.signOut,
                icon: const Icon(Icons.logout_rounded, color: Colors.white)),
          ]),
        ),
        Expanded(
          child: StreamBuilder<QuerySnapshot<Map<String, dynamic>>>(
            stream: q.snapshots(),
            builder: (c, s) {
              if (!s.hasData) return const Loading();
              final docs = s.data!.docs;
              if (docs.isEmpty) {
                return EmptyState(
                  icon: Icons.class_outlined,
                  title: 'ยังไม่มีชั้นเรียน',
                  hint: isT ? 'กด "สร้างชั้นเรียน" แล้วแจกรหัสห้องให้นักศึกษา' : 'กด "เข้าร่วมชั้นเรียน" แล้วใส่รหัสห้องจากอาจารย์',
                );
              }
              return ListView.separated(
                padding: const EdgeInsets.fromLTRB(16, 18, 16, 96),
                itemCount: docs.length,
                separatorBuilder: (_, __) => const SizedBox(height: 12),
                itemBuilder: (c, i) {
                  final d = docs[i];
                  final tile = kTiles[d.id.hashCode.abs() % kTiles.length];
                  final members = (d['members'] as List).length;
                  return Material(
                    color: Colors.white,
                    borderRadius: BorderRadius.circular(20),
                    child: InkWell(
                      borderRadius: BorderRadius.circular(20),
                      onTap: () => Navigator.push(
                          context,
                          MaterialPageRoute(
                              builder: (_) => isT
                                  ? TeacherClass(id: d.id, data: d.data())
                                  : StudentClass(id: d.id, data: d.data(), user: user))),
                      child: Container(
                        padding: const EdgeInsets.all(14),
                        decoration: BoxDecoration(
                            borderRadius: BorderRadius.circular(20), border: Border.all(color: kLine)),
                        child: Row(children: [
                          Container(
                            width: 52,
                            height: 52,
                            decoration: BoxDecoration(
                                color: tile.withValues(alpha: 0.14), borderRadius: BorderRadius.circular(16)),
                            child: Icon(Icons.menu_book_rounded, color: tile),
                          ),
                          const SizedBox(width: 14),
                          Expanded(
                            child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
                              Text('${d['name']}',
                                  maxLines: 1,
                                  overflow: TextOverflow.ellipsis,
                                  style: const TextStyle(fontSize: 16, fontWeight: FontWeight.w600)),
                              const SizedBox(height: 2),
                              Text(
                                  isT
                                      ? '${d['subjectCode']}  •  $members คน'
                                      : '${d['subjectCode']}',
                                  style: const TextStyle(color: kMuted, fontSize: 13)),
                            ]),
                          ),
                          if (isT)
                            Container(
                              padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 6),
                              decoration: BoxDecoration(color: kPaper, borderRadius: BorderRadius.circular(10)),
                              child: Text('${d['code']}',
                                  style: const TextStyle(
                                      fontWeight: FontWeight.w700, letterSpacing: 1.5, color: kBlueDeep)),
                            )
                          else
                            const Icon(Icons.chevron_right_rounded, color: kMuted),
                        ]),
                      ),
                    ),
                  );
                },
              );
            },
          ),
        ),
      ]),
    );
  }
}

