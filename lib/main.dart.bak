}

class CheckTab extends StatelessWidget {
  final String classId, code;
  const CheckTab({super.key, required this.classId, required this.code});

  Future<void> openSession(BuildContext c) async {
    try {
      final p = await getPos();
      await db.collection('classes/$classId/sessions').add({
        'open': true,
        'startedAt': FieldValue.serverTimestamp(),
        'lat': p.latitude,
        'lng': p.longitude,
        'radius': kRadiusMeters,
        'lateMin': kLateMinutes,
      });
    } catch (e) {
      if (c.mounted) toast(c, e.toString());
    }
  }

  @override
  Widget build(BuildContext context) => StreamBuilder<QuerySnapshot<Map<String, dynamic>>>(
        stream: db.collection('classes/$classId/sessions').where('open', isEqualTo: true).snapshots(),
        builder: (c, s) {
          if (!s.hasData) return const Loading();
          if (s.data!.docs.isEmpty) {
            return Center(
              child: Padding(
                padding: const EdgeInsets.all(28),
                child: Column(mainAxisSize: MainAxisSize.min, children: [
                  const Text('รหัสเข้าร่วมห้อง', style: TextStyle(color: kMuted)),
                  const SizedBox(height: 8),
                  GestureDetector(
                    onTap: () {
                      Clipboard.setData(ClipboardData(text: code));
                      toast(context, 'คัดลอกรหัสห้องแล้ว');
                    },
                    child: Container(
                      padding: const EdgeInsets.symmetric(horizontal: 22, vertical: 12),
                      decoration: BoxDecoration(
                          color: Colors.white, borderRadius: BorderRadius.circular(16), border: Border.all(color: kLine)),
                      child: Row(mainAxisSize: MainAxisSize.min, children: [
                        Text(code,
                            style: const TextStyle(
                                fontSize: 32, fontWeight: FontWeight.w700, letterSpacing: 4, color: kBlueDeep)),
                        const SizedBox(width: 10),
                        const Icon(Icons.copy_rounded, size: 18, color: kMuted),
                      ]),
                    ),
                  ),
                  const SizedBox(height: 8),
                  const Text('แตะเพื่อคัดลอก แล้วส่งให้นักศึกษา', style: TextStyle(color: kMuted, fontSize: 13)),
                  const SizedBox(height: 36),
                  FilledButton.icon(
                    onPressed: () => openSession(context),
                    icon: const Icon(Icons.qr_code_2_rounded),
                    label: const Text('เปิดเช็คชื่อ'),
                  ),
                ]),
              ),
            );
          }
          final sess = s.data!.docs.first;
          // หน้าจอ QR: เต็มจอสีน้ำเงิน ตั๋ว QR สีขาวอยู่กลาง
          return Container(
            width: double.infinity,
            margin: const EdgeInsets.all(12),
            decoration: BoxDecoration(
              gradient: const LinearGradient(
                  begin: Alignment.topCenter, end: Alignment.bottomCenter, colors: [kBlue, kBlueDeep]),
              borderRadius: BorderRadius.circular(28),
            ),
            child: Column(mainAxisAlignment: MainAxisAlignment.center, children: [
              const Text('ให้นักศึกษาสแกน QR นี้',
                  style: TextStyle(color: Colors.white, fontSize: 18, fontWeight: FontWeight.w600)),
              const SizedBox(height: 4),
              const Text('ต้องอยู่ในรัศมีที่กำหนดจึงจะสแกนผ่าน', style: TextStyle(color: Colors.white70, fontSize: 13)),
              const SizedBox(height: 20),
              Container(
                padding: const EdgeInsets.all(18),
                decoration: BoxDecoration(
                  color: Colors.white,
                  borderRadius: BorderRadius.circular(28),
                  boxShadow: [
                    BoxShadow(color: kInk.withValues(alpha: 0.25), blurRadius: 30, offset: const Offset(0, 12))
                  ],
                ),
                child: QrImageView(
                  data: 'cc|$classId|${sess.id}',
                  size: 240,
                  backgroundColor: Colors.white,
                  eyeStyle: const QrEyeStyle(eyeShape: QrEyeShape.square, color: kInk),
                  dataModuleStyle: const QrDataModuleStyle(dataModuleShape: QrDataModuleShape.square, color: kInk),
                ),
              ),
              const SizedBox(height: 24),
              StreamBuilder<QuerySnapshot<Map<String, dynamic>>>(
                stream: sess.reference.collection('records').snapshots(),
                builder: (c, r) => Column(children: [
                  Text('${r.data?.docs.length ?? 0}',
                      style: const TextStyle(color: Colors.white, fontSize: 48, fontWeight: FontWeight.w700, height: 1)),
                  const Text('คนเช็คชื่อแล้ว', style: TextStyle(color: Colors.white70)),
                ]),
              ),
              const SizedBox(height: 24),
              TextButton.icon(
                style: TextButton.styleFrom(
                  foregroundColor: Colors.white,
                  backgroundColor: Colors.white.withValues(alpha: 0.18),
                  padding: const EdgeInsets.symmetric(horizontal: 22, vertical: 12),
                  shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(14)),
                ),
                onPressed: () => sess.reference.update({'open': false}),
                icon: const Icon(Icons.stop_circle_outlined),
                label: const Text('ปิดการเช็คชื่อ'),
              ),
            ]),
          );
        },
      );
}

class ReportTab extends StatefulWidget {
  final String classId;
  const ReportTab({super.key, required this.classId});
  @override
  State<ReportTab> createState() => _ReportState();
}

class _ReportState extends State<ReportTab> {
  String? sid;
  @override
  Widget build(BuildContext context) {
    final base = 'classes/${widget.classId}';
    return StreamBuilder<QuerySnapshot<Map<String, dynamic>>>(
      stream: db.collection('$base/sessions').orderBy('startedAt', descending: true).snapshots(),
      builder: (c, ss) {
        if (!ss.hasData) return const Loading();
        final sessions = ss.data!.docs;
        if (sessions.isEmpty) {
          return const EmptyState(
              icon: Icons.insert_chart_outlined_rounded,
              title: 'ยังไม่มีการเช็คชื่อ',
              hint: 'เปิดเช็คชื่อในแท็บแรก แล้วผลจะมาแสดงที่นี่');
        }
        sid ??= sessions.first.id;
        final current = sessions.any((e) => e.id == sid) ? sid : sessions.first.id;
        return Column(children: [
          Padding(
            padding: const EdgeInsets.fromLTRB(16, 14, 16, 6),
            child: Container(
              padding: const EdgeInsets.symmetric(horizontal: 14),
              decoration: BoxDecoration(
                  color: Colors.white, borderRadius: BorderRadius.circular(14), border: Border.all(color: kLine)),
              child: DropdownButtonHideUnderline(
                child: DropdownButton<String>(
                  value: current,
                  isExpanded: true,
                  borderRadius: BorderRadius.circular(14),
                  icon: const Icon(Icons.expand_more_rounded),
                  items: [
                    for (final s in sessions)
                      DropdownMenuItem(
                          value: s.id, child: Text('คาบ ${fmt((s['startedAt'] as Timestamp?)?.toDate())}')),
                  ],
                  onChanged: (v) => setState(() => sid = v),
                ),
              ),
            ),
          ),
          Expanded(
            child: StreamBuilder<QuerySnapshot<Map<String, dynamic>>>(
              stream: db.collection('$base/students').snapshots(),
              builder: (c, st) => StreamBuilder<QuerySnapshot<Map<String, dynamic>>>(
                stream: db.collection('$base/sessions/$current/records').snapshots(),
                builder: (c, rs) {
                  if (!st.hasData || !rs.hasData) return const Loading();
                  final rec = {for (final d in rs.data!.docs) d.id: d.data()};
                  final students = st.data!.docs.toList()
                    ..sort((a, b) => '${a['studentId']}'.compareTo('${b['studentId']}'));
                  final rows = <List<String>>[];
                  var ok = 0, late = 0, absent = 0;
                  for (var i = 0; i < students.length; i++) {
                    final s = students[i];
                    final r = rec[s.id];
                    final status = r?['status'] ?? 'ขาด';
                    if (status == 'ตรงเวลา') ok++;
                    if (status == 'สาย') late++;
                    if (status == 'ขาด') absent++;
                    rows.add([
                      '${i + 1}',
                      '${s['studentId']}',
                      '${s['name']}',
                      status,
                      fmtTime((r?['time'] as Timestamp?)?.toDate()),
                    ]);
                  }
                  return ListView(padding: const EdgeInsets.fromLTRB(16, 8, 16, 24), children: [
                    StatusBar(ok: ok, late: late, absent: absent),
                    Align(
                      alignment: Alignment.centerRight,
                      child: TextButton.icon(
                        icon: const Icon(Icons.copy_rounded, size: 18),
                        label: const Text('คัดลอกเป็น CSV (วางใน Excel)'),
                        onPressed: () {
                          final csv =
                              '\uFEFFลำดับ,รหัส,ชื่อ-สกุล,สถานะ,เวลา\n${rows.map((r) => r.join(',')).join('\n')}';
                          Clipboard.setData(ClipboardData(text: csv));
                          toast(context, 'คัดลอกแล้ว นำไปวางใน Excel ได้เลย');
                        },
                      ),
                    ),
                    if (rows.isEmpty)
                      const Padding(
                        padding: EdgeInsets.only(top: 24),
                        child: Center(child: Text('ยังไม่มีนักศึกษาเข้าร่วมห้องนี้', style: TextStyle(color: kMuted))),
                      ),
                    for (final r in rows)
                      Container(
                        margin: const EdgeInsets.only(bottom: 8),
                        padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 12),
                        decoration: BoxDecoration(
                            color: Colors.white,
                            borderRadius: BorderRadius.circular(16),
                            border: Border.all(color: kLine)),
                        child: Row(children: [
                          Container(
                            width: 4,
                            height: 36,
                            decoration: BoxDecoration(
                                color: statusColor(r[3]), borderRadius: BorderRadius.circular(4)),
                          ),
                          const SizedBox(width: 12),
                          Expanded(
                            child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
                              Text(r[2], style: const TextStyle(fontWeight: FontWeight.w600)),
                              Text('${r[1]}   ${r[4]}', style: const TextStyle(color: kMuted, fontSize: 12.5)),
                            ]),
                          ),
                          StatusChip(r[3]),
                        ]),
                      ),
                  ]);
                },
              ),
            ),
          ),
        ]);
      },
    );
  }
}

// ---------- student ----------
class StudentClass extends StatelessWidget {
  final String id;
  final Map<String, dynamic> data, user;
  const StudentClass({super.key, required this.id, required this.data, required this.user});

  @override
  Widget build(BuildContext context) => Scaffold(
        appBar: AppBar(title: Text(data['name'])),
        floatingActionButton: FloatingActionButton.extended(
          onPressed: () => Navigator.push(context, MaterialPageRoute(builder: (_) => ScanPage(user: user))),
          icon: const Icon(Icons.qr_code_scanner_rounded),
          label: const Text('สแกนเช็คชื่อ'),
        ),
        body: StreamBuilder<QuerySnapshot<Map<String, dynamic>>>(
          stream: db.collection('classes/$id/sessions').orderBy('startedAt', descending: true).snapshots(),
          builder: (c, s) {
            if (!s.hasData) return const Loading();
            if (s.data!.docs.isEmpty) {
              return const EmptyState(
                  icon: Icons.event_available_outlined,
                  title: 'ยังไม่มีการเช็คชื่อ',
                  hint: 'เมื่อครูเปิดเช็คชื่อ กด "สแกนเช็คชื่อ" แล้วสแกน QR บนจอ');
            }
            return ListView(padding: const EdgeInsets.fromLTRB(16, 8, 16, 96), children: [
              const Padding(
                padding: EdgeInsets.only(left: 4, bottom: 10),
                child: Text('ประวัติการเข้าเรียน', style: TextStyle(fontSize: 17, fontWeight: FontWeight.w600)),
              ),
              for (final d in s.data!.docs)
                FutureBuilder<DocumentSnapshot<Map<String, dynamic>>>(
                  future: d.reference.collection('records').doc(auth.currentUser!.uid).get(),
                  builder: (c, r) {
                    final status = r.hasData
                        ? (r.data!.exists ? r.data!['status'] : (d['open'] == true ? 'ยังไม่เช็ค' : 'ขาด'))
                        : '...';
                    return Container(
                      margin: const EdgeInsets.only(bottom: 8),
                      padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 14),
                      decoration: BoxDecoration(
                          color: Colors.white,
                          borderRadius: BorderRadius.circular(16),
                          border: Border.all(color: kLine)),
                      child: Row(children: [
                        const Icon(Icons.event_note_outlined, color: kMuted),
                        const SizedBox(width: 12),
                        Expanded(child: Text(fmt((d['startedAt'] as Timestamp?)?.toDate()))),
                        StatusChip(status),
                      ]),
                    );
                  },
                ),
            ]);
          },
        ),
      );
}

class ScanPage extends StatefulWidget {
  final Map<String, dynamic> user;
  const ScanPage({super.key, required this.user});
  @override
  State<ScanPage> createState() => _ScanState();
}

class _ScanState extends State<ScanPage> {
  bool busy = false;

  Future<void> onCode(String raw) async {
    if (busy) return;
    busy = true;
    try {
      final parts = raw.split('|');
      if (parts.length != 3 || parts[0] != 'cc') throw 'QR ไม่ถูกต้อง';
      final cid = parts[1], sid = parts[2], uid = auth.currentUser!.uid;
      final s = await db.doc('classes/$cid/sessions/$sid').get();
      if (!s.exists || s['open'] != true) throw 'การเช็คชื่อนี้ปิดแล้ว';
      final stu = await db.doc('classes/$cid/students/$uid').get();
      if (!stu.exists) throw 'คุณไม่ได้อยู่ในชั้นเรียนนี้';
      final p = await getPos();
      final dist = Geolocator.distanceBetween(p.latitude, p.longitude, s['lat'], s['lng']);
      if (dist > (s['radius'] as num)) throw 'อยู่นอกรัศมี (ห่าง ${dist.round()} เมตร)';
      final started = (s['startedAt'] as Timestamp?)?.toDate() ?? DateTime.now();
      final isLate = DateTime.now().difference(started).inMinutes > (s['lateMin'] as num);
      await db.doc('classes/$cid/sessions/$sid/records/$uid').set({
        'name': widget.user['name'],
        'studentId': widget.user['studentId'],
        'status': isLate ? 'สาย' : 'ตรงเวลา',
        'time': FieldValue.serverTimestamp(),
        'distance': dist.round(),
      });
      if (mounted) {
        toast(context, 'เช็คชื่อสำเร็จ (${isLate ? 'สาย' : 'ตรงเวลา'})');
        Navigator.pop(context);
      }
    } catch (e) {
      if (mounted) toast(context, e.toString());
      await Future.delayed(const Duration(seconds: 2));
      busy = false;
    }
  }

  @override
  Widget build(BuildContext context) => Scaffold(
        extendBodyBehindAppBar: true,
        appBar: AppBar(
          backgroundColor: Colors.transparent,
          foregroundColor: Colors.white,
          title: const Text('สแกน QR เพื่อเช็คชื่อ', style: TextStyle(color: Colors.white)),
        ),
        body: Stack(fit: StackFit.expand, children: [
          MobileScanner(onDetect: (cap) {
            final v = cap.barcodes.isNotEmpty ? cap.barcodes.first.rawValue : null;
            if (v != null) onCode(v);
          }),
          IgnorePointer(
            child: Center(
              child: Container(
                width: 260,
                height: 260,
                decoration: BoxDecoration(
                    border: Border.all(color: Colors.white, width: 3), borderRadius: BorderRadius.circular(32)),
              ),
            ),
          ),
          Positioned(
            left: 0,
            right: 0,
            bottom: 64,
            child: Center(
              child: Container(
                padding: const EdgeInsets.symmetric(horizontal: 18, vertical: 10),
                decoration:
                    BoxDecoration(color: Colors.black54, borderRadius: BorderRadius.circular(24)),
                child: const Text('จ่อกล้องไปที่ QR บนจอของอาจารย์', style: TextStyle(color: Colors.white)),
              ),
            ),
          ),
        ]),
      );
}