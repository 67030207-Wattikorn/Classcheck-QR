        length: 2,
        child: Scaffold(
          appBar: AppBar(
            title: Text(data['name']),
            bottom: const TabBar(
              labelColor: kBlueDeep,
              unselectedLabelColor: kMuted,
              indicatorColor: kBlue,
              dividerColor: kLine,
              tabs: [Tab(text: 'เช็คชื่อ'), Tab(text: 'รายงาน')],
            ),
          ),
          body: TabBarView(children: [CheckTab(classId: id, code: data['code']), ReportTab(classId: id)]),
        ),
